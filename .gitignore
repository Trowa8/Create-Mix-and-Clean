# --- MCreator project ignores ---
# Generated thumbnails, backups, and cache
.mcreator/workspaceBackups/
.mcreator/modElementThumbnails/
.mcreator/localizationcache/
.mcreator/caches/
.mcreator/tmp/
.mcreator/plugins/*/build/
.mcreator/generatorGradleCache

# --- Minecraft runtime folders ---
run/
build/
out/
logs/
bin/

# --- Gradle caches and wrappers ---
.gradle/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --- Eclipse / IntelliJ / VSCode project files ---
.classpath
.project
.settings/
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- OS-specific files ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Backup and temporary files ---
*.bak
*.tmp
*.log
*.swp
*.swo

# --- Build artifacts ---
*.jar
*.zip
*.tar.gz
*.7z

# --- MCreator export artifacts ---
/export/

.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath
.mcreator/generatorGradleCache
